.git
.gitignore
.claude
docs
__tests__
*.test.*

# 本地配置文件
tsconfig.tsbuildinfo
config copy.json

# 环境变量（保留 .env.production 打入镜像供运行时加载）
.env
.env.development
.env.test

# RSA 密码解密私钥（不进构建上下文与镜像层；运行时由 docker-compose 只读挂载）
keys
