# 复制为 services/whisper/.env 后使用：
#   cp .env.example .env && chmod 600 .env
#
# 该文件已在 .gitignore 中排除，且不会被 COPY 进镜像。

# ---- 共享密钥（必填）----
# Node 侧必须配置同一个值（WHISPER_API_TOKEN，见 .env.development / .env.production），
# 否则接口一律 401。生产环境该值来自 app 镜像内的 .env.production。
WHISPER_API_TOKEN=change-me-please

# ---- 服务/引擎参数：**请在 docker-compose.yml 的 environment 里改** ----
# 这些键在 compose 的 environment 中是字面量，而 compose 的 environment 优先级高于
# env_file —— 所以在本文件里写同名键**不会生效**，只是白纸一张。
#
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_LANGUAGE=zh
#
# WHISPER_EAGER_LOAD=true
# WHISPER_MAX_QUEUE=64
# WHISPER_MAX_UPLOAD_MB=100
# WHISPER_ALLOW_DOWNLOAD=true
# WHISPER_RESULT_TTL_MS=1800000
# WHISPER_EXPOSE_TRACE=false
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=true
# WHISPER_MAX_CHARS_PER_CUE=20
