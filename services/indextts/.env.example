# 复制为 services/indextts/.env 后使用：
#   cp .env.example .env && chmod 600 .env
#
# 该文件已在 .gitignore 中排除，且不会被 COPY 进镜像。

# ---- 共享密钥（必填）----
# Node 侧必须配置同一个值（INDEXTTS_API_TOKEN），否则接口一律 401。
# 生产环境该值来自 app 镜像内的 .env.production（Dockerfile 会 COPY 它，容器启动时
# dotenv 读取）。注意不能靠 app 的 docker-compose.yml 里写 ${INDEXTTS_API_TOKEN:?} 来注入 ——
# compose 的插值只认 shell 环境变量与 compose 项目根目录的 .env，读不到 .env.production，
# 那样写只会让构建期直接失败。
INDEXTTS_API_TOKEN=change-me-please

# ---- 服务参数：**请在 docker-compose.yml 的 environment 里改** ----
# 这些键在 compose 的 environment 中是字面量，而 compose 的 environment 优先级高于
# env_file —— 所以在本文件里写同名键**不会生效**，只是白纸一张。
# INDEXTTS_EAGER_LOAD=true
# INDEXTTS_MAX_QUEUE=64
# INDEXTTS_MAX_TEXT_CHARS=5000    # 须与 Node 侧 .env 的 INDEXTTS_MAX_TEXT_CHARS 一致
# INDEXTTS_MAX_UPLOAD_MB=20
# INDEXTTS_RESULT_TTL_MS=1800000
# INDEXTTS_EXPOSE_TRACE=false

# ---- 采样参数（不设则用引擎默认值）----
# INDEXTTS_TEMPERATURE=0.8
# INDEXTTS_TOP_P=0.8
# INDEXTTS_TOP_K=30
# INDEXTTS_INTERVAL_SILENCE=200
# 注意：段长配置对 HTTP/stdio 克隆路径**无效** —— indextts_engine.py 里被 SPEED_PRESETS
# （fast/balanced/quality = 80/72/140 token）覆盖，设了也不生效。要调请改 SPEED_PRESETS。
# INDEXTTS_MAX_TEXT_TOKENS_PER_SEGMENT=120
# INDEXTTS_CLONE_TEMPERATURE=0.75
