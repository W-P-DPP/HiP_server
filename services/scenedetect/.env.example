# 复制为 services/scenedetect/.env 后使用：
#   cp .env.example .env && chmod 600 .env
#
# 该文件已在 .gitignore 中排除，且不会被 COPY 进镜像。

# ---- 共享密钥（必填）----
# Node 侧必须配置同一个值（SCENEDETECT_API_TOKEN，见 .env.development / .env.production），
# 否则接口一律 401。生产环境该值来自 app 镜像内的 .env.production，
# 并由 deploy.sh 的 ensure_service_env 自动同步到本文件。
# 留空 = 不鉴权（仅限回环/内网部署）。
SCENEDETECT_API_TOKEN=change-me-please

# ---- 服务参数：**请在 docker-compose.yml 的 environment 里改** ----
# 这些键在 compose 的 environment 中是字面量，而 compose 的 environment 优先级高于
# env_file —— 所以在本文件里写同名键**不会生效**。
#
# SCENEDETECT_MAX_CONCURRENCY=1
# SCENEDETECT_ALLOWED_ROOT=/app/uploads
