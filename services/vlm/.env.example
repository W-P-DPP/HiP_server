# 复制为 services/vlm/.env 后使用：
#   cp .env.example .env && chmod 600 .env
#
# 该文件已在 .gitignore 中排除，且不会被 COPY 进镜像。

# ---- 共享密钥（必填）----
# Node 侧必须配置同一个值（VLM_API_TOKEN，见 .env.development / .env.production），
# 否则接口一律 401。生产环境该值来自 app 镜像内的 .env.production。
VLM_API_TOKEN=F0dgAYbCr8KjWCn2gq9XVh01PfCH9RxiZbasN6EW

# ---- 服务/引擎参数：**请在 docker-compose.yml 的 environment 里改** ----
# 这些键在 compose 的 environment 中是字面量，而 compose 的 environment 优先级高于
# env_file —— 所以在本文件里写同名键**不会生效**，只是白纸一张。
#
# VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
# VLM_DEVICE=cuda
# VLM_ATTN=sdpa
# VLM_LOAD_IN_4BIT=true
# VLM_MIN_PIXELS=3136
# VLM_MAX_PIXELS=1003520
# VLM_MAX_NEW_TOKENS=2048
#
# VLM_EAGER_LOAD=false
# VLM_IDLE_UNLOAD_MS=600000
# VLM_MAX_QUEUE=64
# VLM_MAX_UPLOAD_MB=20
# VLM_RESULT_TTL_MS=1800000
# VLM_EXPOSE_TRACE=false
# VLM_ALLOW_DOWNLOAD=true
