{
  "name": "general-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:unit": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs __tests__/unit",
    "test:integration": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs __tests__/integration",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "stress": "cross-env NODE_ENV=test tsx __tests__/stress/run.ts",
    "stress:spike": "cross-env NODE_ENV=test tsx __tests__/stress/run.ts --scenario spike",
    "stress:soak": "cross-env NODE_ENV=test tsx __tests__/stress/run.ts --scenario soak",
    "dev": "cross-env NODE_ENV=development nodemon --exec \"tsx\" ./main.ts",
    "build": "cross-env NODE_ENV=production vite build",
    "start": "cross-env NODE_ENV=production node dist/main.cjs"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "ts,json",
    "ignore": [
      "node_modules",
      "dist",
      "logs",
      "uploads",
      ".runtime",
      "services/heygem/data",
      "services/indextts/engine",
      "services/indextts/logs",
      "services/scenedetect/engine",
      "services/vlm/engine"
    ]
  },
