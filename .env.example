# ===========================================
# 开发环境示例（复制为 .env.development 使用）
#   cp .env.example .env.development
# 所有 <...> 占位符都要替换为你自己的值；真实凭证不入库。
# ===========================================

HIP_VERSION=1.3.1

# ---- 服务器 ----
PORT=50010
NODE_ENV=development
# 服务器公网可达的基础 URL（仅 origin，不含路径）；生产环境改为 https://公网域名
SERVER_URL=http://localhost:50010

# ---- 时区 ----
# 进程时区固定在 utils/constant/SystemConstants.ts（两环境同值 Asia/Shanghai）

# ---- 服务端 HTTP ----
# JSON 请求体解析上限固定在 utils/constant/HttpConstants.ts（两环境同值 10mb）

# ---- JWT 认证 ----
JWT_ENABLED=true
# 务必换成强随机值：openssl rand -hex 32
JWT_SECRET=<强随机密钥>
# JWT_EXPIRES_IN 固定在 utils/constant/JwtConstants.ts（两环境同值 7200）

# ---- OAuth 授权服务器 ----
# OAUTH_USER_ID / OAUTH_ACCESS_TOKEN_TTL / OAUTH_REFRESH_TOKEN_TTL 固定在 utils/constant/OAuthConstants.ts（两环境同值）

# ---- 日志 ----
# LOG_ROTATE / LOG_DATE_PATTERN 固定在 utils/constant/LogConstants.ts（两环境同值）
LOG_MAX_FILES=1d

# ---- Axios ----
# AXIOS_BASE_URL / AXIOS_TIMEOUT 固定在 utils/constant/AxiosConstants.ts（两环境同值）

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

# ---- mysql 数据库 ----
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<数据库密码>
DB_NAME=wxbot
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0
DB_TIMEZONE=+08:00
DB_CHARSET=utf8mb4

# ---- MongoDB 数据库 ----
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=<MongoDB 密码>
MONGO_DATABASE=HiP
MONGO_AUTH_SOURCE=
# MONGO_URL=mongodb://<user>:<password>@127.0.0.1:27017/HiP?authSource=admin

# ---- 文件服务 ----
# FILE_UPLOAD_DIR / FILE_MAX_SIZE / FILE_ALLOWED_TYPES / FILE_STATIC_PREFIX 固定在 utils/constant/FileConstants.ts（两环境同值）

# ---- 操作日志 ----
# OPERATION_LOG_ENABLED 固定在 utils/constant/OperationLogConstants.ts（两环境同值 true）

# ---- 邮件服务 ----
MAILER_HOST=smtp.qq.com
MAILER_PORT=465
MAILER_SECURE=true
MAILER_USER=<发件邮箱>
MAILER_PASS=<邮箱 SMTP 授权码>
# 发件人地址（缺省回退 MAILER_USER）与显示名（可选）
MAILER_FROM=
MAILER_FROM_NAME=HiP
# 总开关：false 时 POST /api/mailer/send 直接返回 503
MAILER_ENABLED=true


# ---- 讯飞服务 ----
# 各接口 URL（AUTH / TRAINTEXT / TRAINTCREATE / ADDSUBMIT / RESULT / RAASR / VOICE_CLONE 等）与 TEXTID 固定在 utils/constant/XunfeiConstants.ts（两环境同值）
XUNFEI_APPID=<讯飞 APPID>
XUNFEI_APISecret=<讯飞 APISecret>
XUNFEI_APIKey=<讯飞 APIKey>
XUNFEI_TRAIN_CALLBACK=https://your-domain.example/dev/hip/api/voiceTrain/trainsCallback



# ---- wx 公众号 ----
WX_APPID=<微信 AppID>
WX_AppSecret=<微信 AppSecret>
WX_EncodingAESKey=<微信 EncodingAESKey>
WX_TOKEN=<微信 Token>
# WX_BaseURL 固定在 utils/constant/wx.ts（两环境同值 https://api.weixin.qq.com）

# 第三方素材
PEXELS_API_KEY=<Pexels API Key>
PIXABAY_API_KEY=<Pixabay API Key>
# MATERIAL_MATCH_THRESHOLD 固定在 utils/constant/MaterialConstants.ts（两环境同值 0.6）

# ── 视频素材库：大文件分片上传（POST /api/videoMaterials/chunks/*） ──
# VIDEO_MATERIAL_MAX_BYTES / VIDEO_MATERIAL_MAX_CHUNK_BYTES / VIDEO_MATERIAL_CHUNK_BYTES / VIDEO_MATERIAL_MAX_CHUNKS / VIDEO_MATERIAL_CHUNK_SESSION_TTL_MS
# 固定在 utils/constant/videoMaterial.ts（两环境同值）

# ffmpeg 硬件编码加速：off=强制 CPU，auto=自动检测（默认），on=启用（缺失时警告降级）
FFMPEG_GPU=auto

# 视频合成任务并发数固定在 utils/constant/video.ts；单用户训练记录上限固定在 utils/constant/VoiceTrainConstants.ts（两环境同值）

# ---- IndexTTS2 音色克隆 ----
# 运行模式：remote=调用独立部署的 GPU 服务容器（推荐）；local=本机 spawn Python worker；off=禁用
INDEXTTS_MODE=remote
# 独立 GPU 服务地址。services/indextts/docker-compose.yml 把端口绑在宿主回环 39010
INDEXTTS_BASE_URL=http://127.0.0.1:39010
# 需与 services/indextts/.env 里的 INDEXTTS_API_TOKEN 一致
INDEXTTS_API_TOKEN=<随机串，须与 services/indextts/.env 一致>
# 其余 INDEXTTS_*（总开关 / 常驻 worker / 预热 / 检出目录与权重 / FP16 / 长文本上限与各类超时等）
# 固定在 utils/constant/indextts.ts（两环境同值）

# ---- 数字人（HeyGem/Duix 对口型） ----
# duix-avatar-gen-video 服务的 HTTP 地址（本机开发直连回环 8383）
HEYGEM_BASE_URL=http://127.0.0.1:8383
# **最关键的两项**：Node 可见的共享挂载目录 ↔ duix 容器内前缀。
# 注意：一台机器上的 duix 只有一个实例，它同一时刻只能挂一份目录。
#   · 生产（hip-server 容器）走全局命名卷 wxbot-heygem-data，duix 也挂该卷；
#   · 本机 pnpm dev 直接写下面这个宿主路径，**只有 duix 也挂在该宿主目录时才有数**。
# 因此这台同时跑生产容器与 dev 进程的机器上，dev 的数字人合成与生产二者只能取其一：
# 需要在本机调数字人时，把 duix 临时挂回宿主目录（会打断生产），或直接走生产环境验证。
# 生产部署务必保持根 docker-compose.yml 的命名卷，勿为 dev 改回相对绑定挂载 ——
# 相对路径按各自 compose 目录解析，Jenkins workspace 与开发检出不同就会各写各的，
# duix 读不到 audio.wav，任务报「三次获取音频时长失败」。
HEYGEM_MOUNT_DIR=services/heygem/data
HEYGEM_CONTAINER_PREFIX=/code/data
# 其余 DIGITALHUMAN_* / HEYGEM_*（总开关 / 运行期目录 / 提交参数 / 调度器并发与各类超时等）
# 固定在 utils/constant/digitalHuman.ts（两环境同值）

# ---- 字幕生成（音频 → SRT） ----
# SUBTITLE_* / ASR_*（总开关 / 通道 / 语种 / 体积上限 / 轮询与调度器等）固定在 utils/constant/subtitle.ts（两环境同值）

# ---- 本地 Whisper（ASR 优先通道，services/whisper 独立 GPU 服务） ----
# 本机开发直连回环；生产在容器内走共享网络的 whisper-server:8000（见 .env.production）。
WHISPER_BASE_URL=http://127.0.0.1:39020
# 须与 services/whisper/.env 的 WHISPER_API_TOKEN 一致
WHISPER_API_TOKEN=<随机串，须与 services/whisper/.env 一致>
# 其余 WHISPER_*（模式 / 兜底语种 / 轮询与超时等）固定在 utils/constant/WhisperConstants.ts（两环境同值）

# ---- 视频生成管道 V2（IndexTTS 配音 + Whisper 字幕 → ffmpeg 烧录） ----
# 管道不持有 GPU 引擎：配音复用 voiceTrainV2 合成任务、字幕复用 subtitle 任务，
# 两段能力是否可用由上面的 INDEXTTS_* / ASR_* / WHISPER_* 决定。
VIDEO_PIPELINE_V2_ENABLED=true
VIDEO_PIPELINE_V2_POLL_INTERVAL_MS=3000
# 在途任务上限（每条最终跑一次 ffmpeg 合成，默认 1）
VIDEO_PIPELINE_V2_CONCURRENCY=1
VIDEO_PIPELINE_V2_PROGRESS_MIN_INTERVAL_MS=1000
VIDEO_PIPELINE_V2_LEASE_TTL_MS=60000
# 陈旧任务阈值。必须大于一次完整管道耗时（配音 + 转写 + 合成），否则中断恢复会误杀长任务。
VIDEO_PIPELINE_V2_TASK_STALE_MS=3600000
# 等待配音子任务的上限。必须 ≥ INDEXTTS_JOB_TIMEOUT_MS。
VIDEO_PIPELINE_V2_VOICE_TIMEOUT_MS=3600000
# 等待字幕子任务的上限。必须 ≥ SUBTITLE_TASK_STALE_MS。
VIDEO_PIPELINE_V2_SUBTITLE_TIMEOUT_MS=1800000

# ---- 解说视频（解说结构化数据 → 先解说后细节两段 + IndexTTS 配音 → 烧录解说字幕成片） ----
# 输入是前端提交的解说结构化数据 + 场景切分任务 id + 音色 id：从场景任务解析源视频，逐段拆成
# 「解说段」（整段 [start,end] 画面去源字幕 + TTS 配音 + 解说字幕）与「细节段」（clips 原切视频，
# 保留原声原字幕），拼接后烧录解说字幕。配音复用 voiceTrainV2 合成任务，画面处理走本机 ffmpeg。
NARRATION_VIDEO_ENABLED=true
NARRATION_VIDEO_POLL_INTERVAL_MS=3000
# 在途任务数上限（每条任务内含 N 段配音 + 多次 ffmpeg，默认 1）
NARRATION_VIDEO_CONCURRENCY=1
NARRATION_VIDEO_PROGRESS_MIN_INTERVAL_MS=1000
NARRATION_VIDEO_LEASE_TTL_MS=60000
# 陈旧任务阈值。必须大于一次完整任务耗时（N 段配音 + 裁剪拼接 + 烧录），否则中断恢复会误杀长任务。
NARRATION_VIDEO_TASK_STALE_MS=7200000
# 等待单段配音子任务的上限。必须 ≥ INDEXTTS_JOB_TIMEOUT_MS。
NARRATION_VIDEO_VOICE_TIMEOUT_MS=3600000
# 字幕烧录样式（留空即用 burnSubtitles 的默认值）
# NARRATION_VIDEO_SUBTITLE_FONT_SIZE=24
# NARRATION_VIDEO_SUBTITLE_FONT_NAME=Microsoft YaHei
# NARRATION_VIDEO_SUBTITLE_COLOR=#FFFFFF
# NARRATION_VIDEO_SUBTITLE_POSITION=bottom
# NARRATION_VIDEO_SUBTITLE_MARGIN_V=24
# 源视频烧死字幕遮罩（仅解说段生效；几何为成片 1280x720 坐标，mode=blur 区域模糊 / box 纯色块）
# NARRATION_VIDEO_SUBTITLE_MASK_ENABLED=true
# NARRATION_VIDEO_SUBTITLE_MASK_MODE=blur
# NARRATION_VIDEO_SUBTITLE_MASK_X=0
# NARRATION_VIDEO_SUBTITLE_MASK_Y=600
# NARRATION_VIDEO_SUBTITLE_MASK_W=1280
# NARRATION_VIDEO_SUBTITLE_MASK_H=120
# NARRATION_VIDEO_SUBTITLE_MASK_BLUR=12

# ---- AI 检测：视频场景切分（PySceneDetect，src/aiDetect） ----
# 场景切分恒走独立部署的 scenedetect HTTP 容器（服务起停见 services/scenedetect/README.md）：
#   cd services/scenedetect && cp .env.example .env && docker compose up -d --build
# 未配置下面的 SCENEDETECT_BASE_URL 时该能力视为未启用（提交即报「场景检测服务未配置」）。
SCENEDETECT_BASE_URL=http://127.0.0.1:39040
# SCENEDETECT_API_TOKEN=<与 services/scenedetect/.env 一致>
# SCENEDETECT_TIMEOUT_MS 固定在 utils/constant/scenedetect.ts（两环境同值 600000）

# 总开关。关闭时 POST /aiDetect/scene/tasks 直接 503，调度器也不启动。
AI_DETECT_ENABLED=true
# 源视频大小上限（字节，默认 2.5GB = 2684354560，与素材库的大文件量级对齐）：既是整份上传路由
# multer 的传输上限（uploadDetectVideo，不受 FILE_MAX_SIZE 约束）与业务上限，也是分片合并后的上限，
# 故超过它的视频在 multer 那层就会被拒并返回 400。
AI_DETECT_MAX_VIDEO_BYTES=2684354560

# ── 场景切分：大文件分片上传（POST /api/aiDetect/scene/chunks/*） ──
# 分片通道自身参数：单片传输上限 / 分片数上限 / 未完成会话存活时长。
# 合并后的体量上限与上方 AI_DETECT_MAX_VIDEO_BYTES 同一口径，不再单独配置。
# 单个分片大小上限（字节，默认 16MB）。同时是该路由 multer 的传输上限，与 FILE_MAX_SIZE 无关。
AI_DETECT_CHUNK_MAX_CHUNK_BYTES=16777216
# 分片数上限（默认 10000）。每片至少落一个文件，防止 totalChunks 被填成天文数字。
AI_DETECT_CHUNK_MAX_CHUNKS=10000
# 未完成分片会话的存活时长（ms，默认 24h）。新建会话时顺带清理超期目录，放弃的上传不会永久占盘。
AI_DETECT_CHUNK_SESSION_TTL_MS=86400000
# 缺省检测算法：content 内容突变 / adaptive 自适应 / threshold 亮度阈值
AI_DETECT_DEFAULT_DETECTOR=content

# ── 场景切分：首尾黑帧检测（提交时 blackDetectSec > 0 才跑） ──
# 用 ffmpeg blackdetect 只扫首尾各 blackDetectSec 秒（不做全片扫描），把贴边的黑场另立为独立场景。
# 「扫多久」由请求参数决定，下面三项是判黑口径。
# 黑场最短时长（秒，ffmpeg 的 d=）。短于此长度的暗帧不算黑场，避免把正常压暗镜头误判成黑场。
AI_DETECT_BLACK_MIN_DURATION_SEC=1
# 整帧判黑所需的「判黑像素」比例下限（pic_th，0..1）。0.98 = 98% 以上像素判黑才算整帧黑。
AI_DETECT_BLACK_PIC_TH=0.98
# 单像素判黑的亮度阈值（pix_th，相对满量程 0..1）。0.1 = 亮度低于满量程 10% 的像素算黑。
AI_DETECT_BLACK_PIX_TH=0.1

# ── 场景抽帧（POST /api/aiDetect/frames/tasks） ──
# 入参是「已完成的场景切分任务 id」而不是源视频：按每个场景的起止时间抽 开始/中间/结束 三帧，
# 原尺寸 jpg，逐帧登记 file 表（category=aiDetectFrame）供图片理解按 fileId 取用。
# 单帧抽帧子进程超时（ms，默认 30000）。抽帧本身是短任务，但一个任务要做 3×场景数 次调用，
# 任一次挂起都会卡住调度器，故独立设一个短超时兜底。
AI_DETECT_FRAME_EXTRACT_TIMEOUT_MS=30000
# 抽帧 jpg 质量（ffmpeg 的 -q:v，2..31，越小质量越好、体积越大，默认 3）。不缩放，体积靠它控制。
AI_DETECT_FRAME_JPEG_QUALITY=3
# 抽帧队列的在途任务数上限（默认 1）。与下方 AI_DETECT_CONCURRENCY 互相独立：抽帧任务在自己的表与
# 队列上领取，占满本额度不会挤掉场景切分的额度（反之亦然）。
AI_DETECT_FRAME_CONCURRENCY=1

# ── 场景转写（POST /api/aiDetect/asr/tasks） ──
# 入参同样是「已完成的场景切分任务 id」：抽音频 → 复用 subtitle 模块的 Whisper 链路转写 →
# 把分段文本按场景区间归并成 [{startMs,endMs,text}]。转写跑在 subtitle 队列上，不占本模块算力。
# 音频切块时长（ms，默认 10 分钟）。因为 subtitle 链路对音频卡 ASR_MAX_AUDIO_BYTES（50MB），而
# 16k 单声道 wav 每秒 32KB ⇒ 约 26 分钟就到顶，长片必须切块；10 分钟块 ≈ 19.2MB，余量充足。
# 调大本值时必须保证 chunkMs/1000 × 32KB ≤ ASR_MAX_AUDIO_BYTES。
AI_DETECT_ASR_CHUNK_MS=600000
# 转写队列的在途任务数上限（默认 1，与另两条队列独立）。真正的算力闸门在 SUBTITLE_CONCURRENCY。
AI_DETECT_ASR_CONCURRENCY=1
# 单块音频提取子进程超时（ms，默认 300000）。只解音轨，10 分钟块通常几秒完成。
AI_DETECT_ASR_EXTRACT_TIMEOUT_MS=300000
# 等待单个块转写完成的上限（ms，默认 1800000 = 30 分钟）。必须 ≥ SUBTITLE_TASK_STALE_MS，
# 否则合法的长块会被本侧提前判超时（与 VIDEO_PIPELINE_V2_SUBTITLE_TIMEOUT_MS 同一条约束）。
AI_DETECT_ASR_SUBTITLE_TIMEOUT_MS=1800000

# url 入参的安全限制：单次下载最大字节数 / 总超时（ms）/ 最大重定向跳数（每跳都重新校验内网地址）
AI_DETECT_URL_MAX_BYTES=209715200
AI_DETECT_URL_TIMEOUT_MS=120000
AI_DETECT_URL_MAX_REDIRECTS=5
# 调度器：轮询间隔 / 进度写库节流（ms）；并发额度分两条队列各配一个，见下方 CONCURRENCY 与上方 FRAME_CONCURRENCY
AI_DETECT_POLL_INTERVAL_MS=3000
# 场景切分队列的在途任务数上限。检测是纯 CPU 逐帧分析，并发只会互相拖慢（0/负值/非数字按 1 处理）。
AI_DETECT_CONCURRENCY=10
AI_DETECT_PROGRESS_MIN_INTERVAL_MS=1000
AI_DETECT_LEASE_TTL_MS=60000
# 陈旧任务阈值。必须大于一次最长检测耗时，否则中断恢复会误杀长任务。
AI_DETECT_TASK_STALE_MS=1800000

# ---- 图片理解（Qwen3-VL，src/vlm / services/vlm） ----
# 全仓库唯一做「视觉语义理解」的能力：图片 → 结构化 JSON（description/objects/actions/sceneType/tags）。
# 容器只做「图片 → 文字」，队列/进度/文件落库/归属校验全在 Node 侧。
# 服务起停见 services/vlm/README.md：
#   cd services/vlm && docker compose up -d --build     （端口绑宿主回环 39030）
# 本机开发直连回环；生产在容器内走共享网络的 vlm-server:8000（见 .env.production）。
VLM_MODE=remote
VLM_BASE_URL=http://127.0.0.1:39030
# 须与 services/vlm/.env 的 VLM_API_TOKEN **完全一致**，否则接口一律 401。
# 起容器后第一个动作就是把下面这行原样拷过去：
#   cd services/vlm && cp .env.example .env && chmod 600 .env
#   # 然后把 .env 里的 VLM_API_TOKEN 改成这一行的值
VLM_API_TOKEN=<随机串，须与 services/vlm/.env 一致>
# 模块总开关。关闭时 POST /vlm/tasks 直接 503，调度器也不启动。
VLM_ENABLED=true
# 源图片上限（字节，默认 20MB）：既是上传路由 multer 的传输上限（uploadVlmImage，不受
# FILE_MAX_SIZE 约束）与业务上限。图片远小于视频，且已远超模型实际会看的像素量。
VLM_MAX_IMAGE_BYTES=20971520
VLM_POLL_INTERVAL_MS=1500
VLM_JOB_TIMEOUT_MS=600000
VLM_READY_TIMEOUT_MS=600000
# 调度器：轮询间隔 / 在途并发 / 进度写库节流（ms）
VLM_DISPATCH_POLL_INTERVAL_MS=3000
# 容器侧 GPU 并发恒为 1（一份热模型），这里放大只会把请求堆在它的队列里。
VLM_CONCURRENCY=1
VLM_PROGRESS_MIN_INTERVAL_MS=1000
VLM_LEASE_TTL_MS=60000
# 陈旧任务阈值。必须大于「容器冷加载模型 + 单图推理」，否则中断恢复会误杀正在跑的任务。
VLM_TASK_STALE_MS=1800000
# 默认指令可覆盖（留空则用 utils/constant/vlm.ts 里的 VLM_DEFAULT_PROMPT / VLM_DEFAULT_TEXT_PROMPT）。
# VLM_DEFAULT_PROMPT=
# VLM_DEFAULT_TEXT_PROMPT=

# ---- 批量图像识别（对场景抽帧关键帧逐张理解，src/vlmBatch） ----
# 复用上面同一套 Qwen3-VL 容器与客户端配置（VLM_MODE/VLM_BASE_URL/…），这里只配**本队列自己的调度器**：
# 独立并发额度、独立 leader 租约键、独立陈旧阈值，与单图队列 VLM_CONCURRENCY 各算各的、互不挤占。
VLM_BATCH_ENABLED=true
# 在途批次任务数上限。容器侧 GPU 并发恒为 1，默认与单图队列一致取 1。
VLM_BATCH_CONCURRENCY=1
VLM_BATCH_DISPATCH_POLL_INTERVAL_MS=3000
VLM_BATCH_LEASE_TTL_MS=60000
# 陈旧任务阈值。必须大于一次完整批次耗时（N 张串行推理，含容器冷加载），故默认 2 小时。
VLM_BATCH_TASK_STALE_MS=7200000

# ---- RSA 密码解密 ----
# 前端用 RSA 公钥（hip-front/src/constant/crypto.ts）加密登录/注册/改密/建子用户提交的密码，
# 后端用这里的私钥解密。**公钥与私钥必须成对**，轮换时两侧同步替换。
# 私钥 PEM 路径（相对 process.cwd()）；私钥不进仓库（见 .gitignore 的 keys/*）。
RSA_PRIVATE_KEY_PATH=./keys/rsa_private.pem
